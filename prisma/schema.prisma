// ReelBhai Academy — database schema
//
// Conventions (read this first):
//  - All money is stored as INTEGER PAISE (₹1 = 100 paise). Never floats.
//  - All timestamps are stored in UTC. The UI converts to Asia/Kolkata.
//  - Percentages are stored as BASIS POINTS (bps): 50% = 5000, 2.5% = 250.
//  - Anything a partner can see about a buyer must be masked in code (see lib/mask.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Users & auth ───────────────────────────────

enum RoleName {
  STUDENT
  PARTNER
  SERVICE_CLIENT
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles       UserRole[]
  sessions    Session[]
  enrollments Enrollment[]
  orders      Order[]
  progress    LessonProgress[]
  partner     Partner?
  playback    PlaybackEvent[]
}

model UserRole {
  id     String   @id @default(cuid())
  userId String
  role   RoleName
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

enum LoginTokenKind {
  OTP // 6-digit code typed by the user
  MAGIC_LINK // long token sent in the "start learning" email after purchase
}

/// One-time login codes and magic links. Only a hash is stored.
model LoginToken {
  id         String         @id @default(cuid())
  email      String
  kind       LoginTokenKind
  tokenHash  String         @unique
  expiresAt  DateTime
  attempts   Int            @default(0)
  consumedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([email, kind, createdAt])
}

/// A logged-in device. Max N active (non-revoked) sessions per user; the oldest is revoked on new login.
model Session {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  userAgent     String?
  deviceLabel   String?
  ipHash        String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// Fixed-window rate limiter stored in Postgres (no extra service needed).
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

// ─────────────────────────────── Funnel tracking ───────────────────────────────

/// Anonymous browser (cookie rb_vid). Lets us connect click → lead → order.
model Visitor {
  id          String   @id
  firstSeenAt DateTime @default(now())
  landingPath String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
}

model FunnelEvent {
  id        String   @id @default(cuid())
  name      String // page_view, cta_click, lead_optin, checkout_start, payment_success, upsell_accepted, lesson_started, lesson_completed
  visitorId String?
  userId    String?
  partnerId String?
  campaign  String?
  path      String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([partnerId, createdAt])
}

enum LeadStatus {
  NEW
  CONVERTED
  UNSUBSCRIBED
}

model Lead {
  id          String     @id @default(cuid())
  email       String?
  phone       String?
  name        String?
  visitorId   String?
  partnerId   String? // attribution captured at opt-in, survives until purchase
  clickId     String?
  campaign    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  status      LeadStatus @default(NEW)
  consentAt   DateTime?
  convertedAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([email])
  @@index([phone])
  @@index([partnerId, createdAt])
}

// ─────────────────────────────── Courses ───────────────────────────────

enum Tier {
  BASIC
  PRO
  DONE_WITH_YOU
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  subtitle    String?
  description String?
  published   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  modules     Module[]
  enrollments Enrollment[]
  products    Product[]
  assets      Asset[]
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  position Int
  /// Minimum tier needed to open this module (e.g. Pro-only bonus modules).
  minTier  Tier     @default(BASIC)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id              String           @id @default(cuid())
  moduleId        String
  title           String
  position        Int
  durationSec     Int              @default(0)
  isFreePreview   Boolean          @default(false)
  /// Which VideoProvider serves this lesson: "mux" | "hls" | "demo"
  videoProvider   String           @default("mux")
  /// Mux: the signed playback ID. HLS: storage key of the playlist.
  videoRef        String?
  body            String? // optional text/notes under the video (markdown-lite)
  /// Optional upgrade prompt shown after this lesson (e.g. after the income module).
  upsellProductSlug String?
  published       Boolean          @default(true)
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assets          Asset[]
  progress        LessonProgress[]
  playback        PlaybackEvent[]

  @@index([moduleId, position])
}

enum AssetKind {
  PDF
  PROMPTS
  TEMPLATE
  IMAGE
  VIDEO
  OTHER
}

/// A private file in R2 (or local storage in dev). Served only via short-lived signed URLs.
model Asset {
  id         String    @id @default(cuid())
  courseId   String?
  lessonId   String?
  kind       AssetKind
  title      String
  storageKey String
  sizeBytes  Int?
  minTier    Tier      @default(BASIC)
  createdAt  DateTime  @default(now())
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson     Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String    @id @default(cuid())
  userId    String
  courseId  String
  tier      Tier
  orderId   String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  positionSec Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

/// Playback log used to flag account sharing (many IPs/cities, impossible watch speed).
model PlaybackEvent {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  sessionId   String?
  event       String // start | progress | complete
  positionSec Int      @default(0)
  ipHash      String?
  city        String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────── Products & pricing ───────────────────────────────

enum ProductKind {
  COURSE_TIER // grants course access at a tier
  SERVICE // done-with-you
  ADDON // order bump (e.g. advanced prompt pack)
}

model Product {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  name                 String
  kind                 ProductKind
  courseId             String?
  tier                 Tier?
  tagline              String?
  /// Bullet list shown in pricing comparison: string[]
  features             Json        @default("[]")
  active               Boolean     @default(true)
  position             Int         @default(0)
  /// Default partner commission for this product, in bps (5000 = 50%).
  defaultCommissionBps Int         @default(5000)
  createdAt            DateTime    @default(now())
  course               Course?     @relation(fields: [courseId], references: [id])
  prices               Price[]
  orderItems           OrderItem[]
  partnerRates         PartnerCommissionRate[]
}

/// Price history. The active price is the newest row with startsAt <= now and (endsAt is null or endsAt > now).
/// A launch price is simply a row with a real endsAt; after it passes, the next row applies automatically.
model Price {
  id          String    @id @default(cuid())
  productId   String
  amountPaise Int
  label       String? // e.g. "Launch price"
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, startsAt])
}

enum CouponKind {
  PERCENT
  FLAT
}

model Coupon {
  id         String     @id @default(cuid())
  code       String     @unique // stored UPPERCASE
  kind       CouponKind
  /// PERCENT: bps (1000 = 10%). FLAT: paise.
  value      Int
  partnerId  String?
  /// null = all products, otherwise string[] of product slugs
  productSlugs Json?
  maxUses    Int?
  usedCount  Int        @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  partner    Partner?   @relation(fields: [partnerId], references: [id])
  orders     Order[]
}

// ─────────────────────────────── Orders & payments ───────────────────────────────

enum OrderStatus {
  CREATED // waiting for payment
  PAID // confirmed by verified webhook ONLY
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AttributionSource {
  COUPON
  COOKIE
  LEAD
  NONE
}

model Order {
  id                String            @id @default(cuid())
  number            Int               @unique @default(autoincrement())
  userId            String?
  email             String
  phone             String
  name              String
  status            OrderStatus       @default(CREATED)
  subtotalPaise     Int
  discountPaise     Int               @default(0)
  /// GST included in totalPaise (0 when not GST-registered)
  taxPaise          Int               @default(0)
  totalPaise        Int
  /// Razorpay fee incl. GST on fee, filled from the webhook payment entity
  gatewayFeePaise   Int?
  currency          String            @default("INR")
  couponId          String?
  gatewayOrderId    String?           @unique
  gatewayPaymentId  String?           @unique
  paidAt            DateTime?
  // Attribution snapshot (frozen at purchase time)
  partnerId         String?
  attributionSource AttributionSource @default(NONE)
  clickId           String?
  leadId            String?
  campaign          String?
  visitorId         String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  city              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user        User?        @relation(fields: [userId], references: [id])
  coupon      Coupon?      @relation(fields: [couponId], references: [id])
  partner     Partner?     @relation(fields: [partnerId], references: [id])
  items       OrderItem[]
  commissions Commission[]
  refunds     Refund[]
  invoice     Invoice?

  @@index([status, paidAt])
  @@index([partnerId, paidAt])
  @@index([email])
}

enum OrderItemKind {
  MAIN
  BUMP
  UPSELL
}

model OrderItem {
  id         String        @id @default(cuid())
  orderId    String
  productId  String
  name       String
  kind       OrderItemKind @default(MAIN)
  unitPaise  Int
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id])
}

model Refund {
  id              String   @id @default(cuid())
  orderId         String
  amountPaise     Int
  gatewayRefundId String?  @unique
  status          String // pending | processed | failed
  reason          String?
  createdById     String?
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id])
}

model Invoice {
  id        String   @id @default(cuid())
  number    String   @unique // e.g. RB-2026-000123 (sequential, required for GST)
  orderId   String   @unique
  data      Json // frozen snapshot of seller/buyer/lines/tax
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
}

/// Every Razorpay webhook we accept. The unique id makes processing idempotent.
model WebhookEvent {
  id          String    @id // x-razorpay-event-id
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
}

enum CheckoutStatus {
  OPEN
  PAID
  ABANDONED
  RECOVERED
}

/// A started checkout (name/phone/email entered). Drives abandoned-cart recovery in Phase 2.
model Checkout {
  id          String         @id @default(cuid())
  visitorId   String?
  email       String
  phone       String
  name        String
  productSlug String
  orderId     String?
  status      CheckoutStatus @default(OPEN)
  recoveryStep Int           @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, updatedAt])
  @@index([email])
}

// ─────────────────────────────── Partners ───────────────────────────────

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Partner {
  id                 String        @id @default(cuid())
  userId             String        @unique
  status             PartnerStatus @default(PENDING)
  /// Referral code used in links: /?ref=CODE
  code               String?       @unique
  displayName        String
  instagramHandle    String
  followers          Int           @default(0)
  niche              String?
  phone              String
  upiId              String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankIfsc           String?
  /// Changing payout details blocks withdrawals for 24h (anti-hijack).
  payoutDetailsUpdatedAt DateTime?
  adminNote          String?
  approvedAt         DateTime?
  createdAt          DateTime      @default(now())

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupons     Coupon[]
  clicks      Click[]
  orders      Order[]
  commissions Commission[]
  rates       PartnerCommissionRate[]
  ledger      PartnerLedger[]
  payouts     Payout[]
}

/// Per-partner override of a product's commission rate.
model PartnerCommissionRate {
  id        String  @id @default(cuid())
  partnerId String
  productId String
  rateBps   Int
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([partnerId, productId])
}

model Click {
  id          String   @id
  partnerId   String
  campaign    String?
  landingPath String?
  visitorId   String?
  /// sha256(ip + daily salt) — never the raw IP
  ipHash      String?
  uaHash      String?
  /// Same visitor+partner+campaign within 30 min counts once
  isDuplicate Boolean  @default(false)
  createdAt   DateTime @default(now())
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([visitorId, createdAt])
}

enum CommissionStatus {
  PENDING // inside refund window
  APPROVED // withdrawable
  REVERSED // order refunded
  PAID // included in a paid withdrawal (informational; money tracked in ledger)
}

model Commission {
  id           String           @id @default(cuid())
  partnerId    String
  orderId      String
  /// Amount the % is applied to: paid − GST − gateway fee
  basePaise    Int
  rateBps      Int
  amountPaise  Int
  status       CommissionStatus @default(PENDING)
  availableAt  DateTime // when the refund window ends
  approvedAt   DateTime?
  reversedAt   DateTime?
  createdAt    DateTime         @default(now())
  partner      Partner          @relation(fields: [partnerId], references: [id])
  order        Order            @relation(fields: [orderId], references: [id])

  @@unique([orderId, partnerId])
  @@index([partnerId, status])
}

enum LedgerType {
  COMMISSION_APPROVED // +amount: becomes withdrawable
  COMMISSION_REVERSED // −amount: refund after approval
  WITHDRAWAL_PAID // −gross amount of a paid withdrawal
  ADJUSTMENT // manual admin correction (audited)
}

/// Every money movement in a partner's wallet. Balance = SUM(amountPaise). Rows are never edited.
model PartnerLedger {
  id           String     @id @default(cuid())
  partnerId    String
  type         LedgerType
  amountPaise  Int // signed
  commissionId String?
  payoutId     String?
  note         String?
  createdAt    DateTime   @default(now())
  partner      Partner    @relation(fields: [partnerId], references: [id])

  @@index([partnerId, createdAt])
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

/// A partner's withdrawal request. Admin approves, pays manually (UPI/bank), then marks paid with a reference.
model Payout {
  id            String       @id @default(cuid())
  partnerId     String
  status        PayoutStatus @default(REQUESTED)
  grossPaise    Int
  tdsBps        Int          @default(0)
  tdsPaise      Int          @default(0)
  netPaise      Int
  /// Snapshot of UPI/bank details at request time
  method        Json
  reference     String? // UTR / transaction id
  rejectReason  String?
  requestedAt   DateTime     @default(now())
  approvedAt    DateTime?
  paidAt        DateTime?
  decidedById   String?
  partner       Partner      @relation(fields: [partnerId], references: [id])

  @@index([partnerId, status])
}

// ─────────────────────────────── CMS, settings, logs ───────────────────────────────

/// Landing page sections editable from admin. key = section id (hero, problem, faq, ...).
model ContentBlock {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  city       String?
  quote      String
  result     String? // e.g. "1.2M views on first reel"
  imageUrl   String?
  published  Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model MessageLog {
  id         String   @id @default(cuid())
  channel    String // email | whatsapp
  to         String
  template   String
  status     String // sent | failed | skipped
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([to, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // e.g. partner.approve, commission.rate_change, refund.create, payout.paid, price.change
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
